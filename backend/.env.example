# ────────────────────────────────────────────────────────────────────────
# Millet Vista RAG — environment example
# Copy this file to `.env` for local development. On Render, set these as
# Environment Variables on the service dashboard. Never commit real keys.
# ────────────────────────────────────────────────────────────────────────

# REQUIRED — your Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyBYRtPWVo4pGE3rHxdQVDH9ynqvuushV5M

# REQUIRED — a long random string used to protect /admin actions
# Tip: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_TOKEN=7a9f67a8547bc41f39f97d4bc8b4d3b588de1b65ba3b0bd72ca56adb13c719bf

# Models — defaults work fine; override only if you know what you're doing
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Server config
PORT=8080
NODE_ENV=development

# Where uploaded PDFs and the vector index live. On Render attach a
# persistent disk and mount it at this path (e.g. /var/data).
DATA_DIR=./data

# CORS — comma separated origins, or * for all
CORS_ORIGIN=*

# Retrieval tuning
TOP_K=6
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
