# ────────────────────────────────────────────────────────────────────────
# THIS IS A TEMPLATE — DO NOT PUT REAL SECRETS HERE.
# This file is committed to git. Anything you write here becomes PUBLIC.
#
# Setup:
#   1. Copy this file to `.env`        →   cp .env.example .env
#   2. Edit `.env` with your real values (it's gitignored, stays private)
#   3. Never edit this file with real values — keep the <PLACEHOLDER>s.
# ────────────────────────────────────────────────────────────────────────

# REQUIRED — your Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=<PASTE-YOUR-GEMINI-KEY-IN-.env-NOT-HERE>

# REQUIRED — a long random string used to protect /admin actions
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=<PASTE-YOUR-LONG-RANDOM-TOKEN-IN-.env-NOT-HERE>

# Models — defaults work fine; override only if you know what you're doing
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Server config
PORT=8080
NODE_ENV=development

# Where uploaded PDFs and the vector index live.
DATA_DIR=./data

# CORS — comma separated origins, or * for all
CORS_ORIGIN=*

# Retrieval tuning
TOP_K=6
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
